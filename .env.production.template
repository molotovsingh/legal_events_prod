# =============================================================================
# PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================
#
# IMPORTANT: This is a TEMPLATE file. Follow these steps:
#
# 1. Copy this file: cp .env.production.template .env.production
# 2. Replace ALL placeholder values marked with <YOUR_*>
# 3. Generate secure secrets using the commands provided in comments
# 4. NEVER commit .env.production to git (already in .gitignore)
#
# Security Checklist:
# ☐ Changed JWT_SECRET_KEY (see generation command below)
# ☐ Changed MINIO_ROOT_USER and MINIO_ROOT_PASSWORD
# ☐ Changed POSTGRES_PASSWORD
# ☐ Set real API keys for your chosen LLM provider(s)
# ☐ Updated domain names for MINIO_PUBLIC_ENDPOINT
# ☐ Enabled MINIO_SECURE=true (requires TLS setup)
# ☐ Set APP_ENV=production
#
# =============================================================================

# -----------------------------------------------------------------------------
# Application Environment
# -----------------------------------------------------------------------------
APP_ENV=production
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# JWT Authentication
# -----------------------------------------------------------------------------
# Generate a secure JWT secret (run this command and paste the output):
# python3 -c "import secrets; print(secrets.token_urlsafe(64))"
#
# SECURITY: This key signs all JWT tokens. Keep it secret and never reuse!
JWT_SECRET_KEY=<YOUR_SECURE_JWT_SECRET_HERE>
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# -----------------------------------------------------------------------------
# PostgreSQL Database
# -----------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=legal_events
POSTGRES_USER=legal_user

# Generate a secure password (run this command and paste the output):
# python3 -c "import secrets; print(secrets.token_urlsafe(32))"
#
POSTGRES_PASSWORD=<YOUR_SECURE_POSTGRES_PASSWORD_HERE>

# -----------------------------------------------------------------------------
# Redis Queue
# -----------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# MinIO Object Storage
# -----------------------------------------------------------------------------
# Internal endpoint (Docker service name)
MINIO_ENDPOINT=minio:9000

# Public endpoint (accessible from browser)
# OPTIONS:
#   1. Direct domain: storage.yourdomain.com:9000
#   2. Behind reverse proxy: storage.yourdomain.com (port 443 for HTTPS)
#   3. Cloud load balancer: your-lb-url.cloud-provider.com
#
# REPLACE WITH YOUR DOMAIN:
MINIO_PUBLIC_ENDPOINT=<YOUR_MINIO_DOMAIN_HERE>

MINIO_BUCKET=legal-documents

# SECURITY: Enable TLS/HTTPS after setting up certificates
# Set to "true" ONLY after TLS is configured (see DEPLOYMENT_GUIDE.md)
MINIO_SECURE=false

# MinIO Admin Credentials
# Generate secure credentials:
# Username: python3 -c "import secrets; print('minio_' + secrets.token_hex(8))"
# Password: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
#
MINIO_ROOT_USER=<YOUR_MINIO_ROOT_USER_HERE>
MINIO_ROOT_PASSWORD=<YOUR_MINIO_ROOT_PASSWORD_HERE>

# MinIO Access/Secret Keys (for application access)
# These can be the same as ROOT credentials or separate (recommended: separate)
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
#
MINIO_ACCESS_KEY=<YOUR_MINIO_ACCESS_KEY_HERE>
MINIO_SECRET_KEY=<YOUR_MINIO_SECRET_KEY_HERE>

# -----------------------------------------------------------------------------
# LLM Provider API Keys
# -----------------------------------------------------------------------------
# INSTRUCTIONS:
# 1. Choose ONE primary provider for production use
# 2. Set only the API key(s) you'll actually use
# 3. Leave unused providers commented out or set to empty string
# 4. Get API keys from provider dashboards:
#    - Google AI Studio: https://makersuite.google.com/app/apikey
#    - OpenRouter: https://openrouter.ai/keys
#    - OpenAI: https://platform.openai.com/api-keys
#    - Anthropic: https://console.anthropic.com/settings/keys
#    - DeepSeek: https://platform.deepseek.com/api-keys
#    - OpenCodeZen: (contact provider for API access)

# Gemini (via Google AI Studio) - Default provider
GOOGLE_API_KEY=<YOUR_GOOGLE_API_KEY_HERE>

# OpenRouter (Multi-model aggregator)
OPENROUTER_API_KEY=<YOUR_OPENROUTER_API_KEY_HERE>

# OpenAI
OPENAI_API_KEY=<YOUR_OPENAI_API_KEY_HERE>

# Anthropic Claude
ANTHROPIC_API_KEY=<YOUR_ANTHROPIC_API_KEY_HERE>

# DeepSeek
DEEPSEEK_API_KEY=<YOUR_DEEPSEEK_API_KEY_HERE>

# OpenCodeZen
OPENCODEZEN_API_KEY=<YOUR_OPENCODEZEN_API_KEY_HERE>

# -----------------------------------------------------------------------------
# Service Ports (Internal Docker Network)
# -----------------------------------------------------------------------------
# These are internal to Docker network, not exposed to host in production
API_PORT=8000
WORKER_PORT=8001
REDIS_PORT=6379
POSTGRES_PORT=5432
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# -----------------------------------------------------------------------------
# CORS Configuration
# -----------------------------------------------------------------------------
# Production domains that can access the API
# IMPORTANT: Replace with your actual frontend domain(s)
# Format: comma-separated list of origins
# Examples:
#   https://app.yourdomain.com
#   https://app.yourdomain.com,https://admin.yourdomain.com
#
CORS_ORIGINS=<YOUR_FRONTEND_DOMAIN_HERE>

# -----------------------------------------------------------------------------
# DEPLOYMENT NOTES
# -----------------------------------------------------------------------------
#
# After filling in all values above:
#
# 1. Verify TLS/HTTPS is configured (see docs/TLS_SETUP_GUIDE.md)
# 2. Test with staging environment first (see .env.staging.template)
# 3. Run security checklist in DEPLOYMENT_GUIDE.md
# 4. Deploy using: docker compose -f docker-compose.yml up -d
# 5. Monitor logs: docker compose logs -f api worker
#
# =============================================================================
