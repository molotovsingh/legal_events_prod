# Legal Events Production - Environment Variables Template
# Copy this file to .env and fill in the values for your environment
# IMPORTANT: Never commit the .env file to version control - it contains secrets!

# ============================================================================
# Database Configuration
# ============================================================================

# PostgreSQL database name
POSTGRES_DB=legal_events

# PostgreSQL username
POSTGRES_USER=legal_user

# PostgreSQL password (MUST be a strong random value in production)
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=generate-strong-password

# ============================================================================
# Redis Configuration
# ============================================================================

# Redis connection URL
# Format: redis://[user:password@]host:port/[db]
REDIS_URL=redis://redis:6379

# ============================================================================
# MinIO (Object Storage) Configuration
# ============================================================================

# MinIO root username
MINIO_ROOT_USER=minioadmin

# MinIO root password (MUST be a strong random value in production)
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
MINIO_ROOT_PASSWORD=generate-strong-password

# MinIO endpoint (internal Docker network or external URL)
MINIO_ENDPOINT=minio:9000

# MinIO public endpoint for presigned URLs
MINIO_PUBLIC_ENDPOINT=localhost:9000

# MinIO bucket name
MINIO_BUCKET=legal-documents

# ============================================================================
# JWT Authentication
# ============================================================================

# JWT Secret Key (MUST be a strong random value in production)
# Used for signing and verifying JWT tokens
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# CRITICAL: This value is required and cannot be left empty
JWT_SECRET_KEY=generate-strong-jwt-secret

# Optional: API Key for admin access
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY_ADMIN=

# Optional: API Key for user access
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY_USER=

# ============================================================================
# LLM Provider API Keys
# ============================================================================

# OpenRouter API Key (optional - if using OpenRouter models)
OPENROUTER_API_KEY=

# Anthropic API Key (optional - if using Claude models)
ANTHROPIC_API_KEY=

# OpenAI API Key (optional - if using GPT models)
OPENAI_API_KEY=

# Google Gemini API Key (optional - if using Gemini models)
GEMINI_API_KEY=

# ============================================================================
# Production Deployment Notes
# ============================================================================

# 1. NEVER commit .env file to version control
# 2. Use strong, randomly-generated passwords for all credentials
# 3. Rotate secrets regularly (at least quarterly)
# 4. Use a secrets management system (AWS Secrets Manager, HashiCorp Vault, etc.)
# 5. Restrict file permissions: chmod 600 .env
# 6. Never log or expose any of these values in application output
#
# Password Generation Command:
# python3 -c "import secrets; print(secrets.token_urlsafe(32))"
#
# Recommended: Use a .env file only for local development
# For production: Use environment variables provided by your deployment platform
# (Docker secrets, Kubernetes secrets, Lambda environment variables, etc.)
