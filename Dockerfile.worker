# Dockerfile for Worker service
FROM python:3.12-slim

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    make \
    libpq-dev \
    tesseract-ocr \
    poppler-utils \
    libmupdf-dev \
    git \
    && rm -rf /var/lib/apt/lists/*

# Copy worker-specific code only
COPY requirements.txt /app/requirements.txt
COPY worker /app/worker

# Copy shared extraction pipeline (read-only)
COPY core /app/core

# Copy utils for file operations
COPY utils /app/utils

# Copy shared infrastructure module
COPY infra /app/infra

# Install Python dependencies (includes langextract from requirements.txt)
RUN pip install --no-cache-dir -r requirements.txt

# Create necessary directories
RUN mkdir -p /app/logs /app/temp

# Default command
CMD ["python", "-m", "worker.main"]
