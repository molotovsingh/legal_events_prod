# =============================================================================
# STAGING ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================
#
# PURPOSE: Test production configuration before deploying to production
#
# INSTRUCTIONS:
# 1. Copy this file: cp .env.staging.template .env.staging
# 2. Replace placeholder values marked with <YOUR_*>
# 3. Use test/demo API keys (not production keys)
# 4. Deploy to separate infrastructure (different server/VPS)
# 5. Run comprehensive tests before promoting to production
#
# Differences from Production:
# ✓ Can use HTTP instead of HTTPS (MINIO_SECURE=false)
# ✓ Can use test API keys with usage limits
# ✓ Shorter JWT expiry for security testing
# ✓ More verbose logging for debugging
#
# =============================================================================

# -----------------------------------------------------------------------------
# Application Environment
# -----------------------------------------------------------------------------
APP_ENV=staging
LOG_LEVEL=DEBUG

# -----------------------------------------------------------------------------
# JWT Authentication
# -----------------------------------------------------------------------------
# Generate a staging JWT secret (different from production):
# python3 -c "import secrets; print(secrets.token_urlsafe(64))"
#
JWT_SECRET_KEY=<YOUR_STAGING_JWT_SECRET_HERE>
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=12

# -----------------------------------------------------------------------------
# PostgreSQL Database
# -----------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=legal_events_staging
POSTGRES_USER=legal_user_staging

# Generate a staging password:
# python3 -c "import secrets; print(secrets.token_urlsafe(32))"
#
POSTGRES_PASSWORD=<YOUR_STAGING_POSTGRES_PASSWORD_HERE>

# -----------------------------------------------------------------------------
# Redis Queue
# -----------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# MinIO Object Storage
# -----------------------------------------------------------------------------
MINIO_ENDPOINT=minio:9000

# Staging public endpoint
# OPTIONS:
#   1. IP address with port: 203.0.113.45:9000
#   2. Subdomain: staging-storage.yourdomain.com
#   3. Keep as localhost:9000 if testing locally
#
MINIO_PUBLIC_ENDPOINT=<YOUR_STAGING_MINIO_ENDPOINT_OR_localhost:9000>

MINIO_BUCKET=legal-documents-staging

# HTTP is acceptable for staging, HTTPS is better
MINIO_SECURE=false

# MinIO staging credentials
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(24))"
#
MINIO_ROOT_USER=<YOUR_STAGING_MINIO_USER_HERE>
MINIO_ROOT_PASSWORD=<YOUR_STAGING_MINIO_PASSWORD_HERE>
MINIO_ACCESS_KEY=<YOUR_STAGING_MINIO_ACCESS_KEY_HERE>
MINIO_SECRET_KEY=<YOUR_STAGING_MINIO_SECRET_KEY_HERE>

# -----------------------------------------------------------------------------
# LLM Provider API Keys
# -----------------------------------------------------------------------------
# STAGING STRATEGY:
# Option A: Use production API keys with low usage (recommended for accuracy)
# Option B: Use separate test/sandbox API keys if provider offers them
# Option C: Use free tier keys (may have rate limits)
#
# Test with the SAME provider you'll use in production

# Gemini (Google AI Studio has generous free tier)
GOOGLE_API_KEY=<YOUR_TEST_GOOGLE_API_KEY_HERE>

# OpenRouter (use test key or low credit balance)
OPENROUTER_API_KEY=<YOUR_TEST_OPENROUTER_API_KEY_HERE>

# OpenAI (use test key or separate project)
OPENAI_API_KEY=<YOUR_TEST_OPENAI_API_KEY_HERE>

# Anthropic (use test key or low credit balance)
ANTHROPIC_API_KEY=<YOUR_TEST_ANTHROPIC_API_KEY_HERE>

# DeepSeek
DEEPSEEK_API_KEY=<YOUR_TEST_DEEPSEEK_API_KEY_HERE>

# OpenCodeZen
OPENCODEZEN_API_KEY=<YOUR_TEST_OPENCODEZEN_API_KEY_HERE>

# -----------------------------------------------------------------------------
# Service Ports
# -----------------------------------------------------------------------------
API_PORT=8000
WORKER_PORT=8001
REDIS_PORT=6379
POSTGRES_PORT=5432
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# -----------------------------------------------------------------------------
# CORS Configuration
# -----------------------------------------------------------------------------
# Staging frontend domain(s)
# Can include localhost for testing
# Example: http://localhost:3000,https://staging.yourdomain.com
#
CORS_ORIGINS=http://localhost:3000,<YOUR_STAGING_FRONTEND_HERE>

# -----------------------------------------------------------------------------
# TESTING CHECKLIST
# -----------------------------------------------------------------------------
#
# After deploying staging environment:
#
# ☐ 1. Verify all services start: docker compose -f docker-compose.staging.yml ps
# ☐ 2. Check API health: curl http://your-staging-url:8000/health
# ☐ 3. Test authentication: Create user, login, verify JWT
# ☐ 4. Test file uploads: Upload to MinIO via API
# ☐ 5. Test document processing: Create run with each provider
# ☐ 6. Test exports: Download CSV, Excel, JSON
# ☐ 7. Test error handling: Invalid inputs, missing files, etc.
# ☐ 8. Monitor logs: docker compose logs -f api worker
# ☐ 9. Check database: Verify data persistence
# ☐ 10. Load testing: Process multiple documents simultaneously
#
# Run automated test suite: ./test_staging.sh
#
# =============================================================================
